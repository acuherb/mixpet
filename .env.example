# ===== MixPet 环境变量配置示例 =====
# 生产部署时复制此文件为 /home/debian/.env 或 /path/to/project/.env 并填入真实值
# 本地开发优先使用项目根目录 .env（已加入 .gitignore，不会提交）
# 启动脚本 start.sh 会自动加载：$HOME/.env > 项目根目录 .env > .env.example
# 复制此文件为 .env 并填写实际值
# 生产环境必须设置所有必需变量；禁止直接把本模板值当生产密钥使用（后端会拒绝启动）
# 生成强随机密钥：python3 -c 'import secrets;print(secrets.token_hex(24))'

# ==================== 数据库 ====================
DB_USER=mixpet
DB_PASSWORD=your_secure_password_here

# ==================== 应用安全 ====================
# 默认密码（新建用户/管理员重置密码）
APP_DEFAULT_PASSWORD=YourSecureDefaultPassword123!

# Remember Me Cookie 签名密钥（至少 32 字符）
REMEMBER_ME_KEY=YourSecureRememberMeKeyAtLeast32Chars!

# JWT 验证码令牌密钥（至少 32 字符）
VERIFY_CODE_SECRET=YourSecureJwtSecretKeyAtLeast32Chars!

# ==================== 邮件服务 ====================
# 开发环境邮箱配置
MAIL_USER=your_qq@qq.com
MAIL_PASS=your_email_auth_code

# ==================== AI 辅助诊疗 ====================
# DeepSeek API Key（可选，启用 AI 功能时需要）
AI_API_KEY=your_deepseek_api_key_here

# ==================== 文件存储路径 ====================
# 可选，使用绝对路径
# PET_AVATAR=/var/mixpet/avatar/
# PET_NOTICE=/var/mixpet/notice/
# PET_CHATIMG=/var/mixpet/chat/
# PET_REPORT=/var/mixpet/report/

# ==================== 生产部署（deploy.sh / prod profile） ====================
# 以下均为 deploy.sh 的可选覆盖项；脚本会把最终值写入 /etc/mixpet/mixpet.env（0640）
# 供 systemd 读取，不会把密钥留在项目目录。
# MIXPET_DOMAIN=pet.yourclinic.com        # 必填：占位域名会被脚本拒绝
# MIXPET_DIR=/opt/mixpet                  # 项目绝对路径，建议纯英文
# MIXPET_ADMIN_MAIL=admin@yourclinic.com # --tls 时接收 Let's Encrypt 到期通知
# SERVER_PORT=8085                       # 后端端口，nginx 反代到此端口
# COOKIE_SECURE=true                     # HTTPS 必须为 true；纯 HTTP 联调才设 false
# BACKUP_DIR=/var/mixpet/backup/         # 备份 .sql 落盘目录
# BACKUP_AUTO_KEEP=14                    # prod 下自动备份保留份数
# MIXPET_DIST=/opt/mixpet/mix-ui/dist    # 前端构建产物目录
# JAVA_BIN=/usr/bin/java                 # systemd ExecStart 使用的 java 路径
# SPRING_PROFILES_ACTIVE=prod            # 由 deploy.sh 自动写入，无需手动设置